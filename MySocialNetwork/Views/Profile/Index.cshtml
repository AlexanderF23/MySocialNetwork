@model MySocialNetwork.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profil";
}

<div class="text-center">
    <h2>@Model.Username's Profil</h2>
    <img src="~/images/placeholder.png" alt="Profilbillede" class="rounded-circle" width="100" height="100">
         
</div>

<hr />

<h3>Opslag</h3>
@if (Model.Posts.Any())
{
    @foreach (var post in Model.Posts)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <samll class="text-muted">@post.CreatedAt.ToString("g")</samll>
                    <p>@post.Content</p>
                </div>
            </div>
    }
}
else
{
    <p>Ingen opslag endnu.</p>
}