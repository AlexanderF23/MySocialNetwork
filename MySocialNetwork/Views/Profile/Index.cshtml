@model List<MySocialNetwork.Models.Post>

<h2>Profil for @ViewBag.Username</h2>

@if (Model.Count == 0)
{
    <p>Igen opslag endnu</p>
}
else
{
    @foreach (var post in Model)
    {
        <div class="card mb-3">
            <div class="card-body">
                <samll class="text-muted">@post.CreatedAt.ToString("g")</samll>
                <p>@post.Content</p>
                
                @if (Context.Session.GetString("User") == post.Username)
                {
                    <a href="/Post/Edit/@post.Id" class="btn btn-sm btn-secondary">Rediger</a>
                    <form method="post" asp-controller="Posts" asp-action="Delete" asp-route-id="@post.Id" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger">Slet</button>
                    </form>
                }
            </div>
        </div>
    }
}