@model MySocialNetwork.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profil";
}

<div class="text-center">
    <h2>@Model.Username's Profil</h2>
    <img src="@Model.ProfilePictureUrl" alt="Profilbillede" class="img-thumbnail" width="150" />
</div>

<div class="ppChanger">
    <form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data">
        <input type="file" name="profilePicture" accept="image/*" />
        <button type="submit" class="btn btn-primary mt-2">Upload billede</button>
    </form>
</div>

<hr />

<h3>Opslag</h3>
@if (Model.Posts.Any())
{
    @foreach (var post in Model.Posts)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <samll class="text-muted">@post.CreatedAt.ToString("g")</samll>
                    <p>@post.Content</p>
                </div>
            </div>
    }
}
else
{
    <p>Ingen opslag endnu.</p>
}